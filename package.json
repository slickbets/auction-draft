{
  "name": "auction-draft",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @auction/web",
    "start": "tsx packages/server/src/main.ts"
  },
  "dependencies": {
    "tsx": "^4.23.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "pg-mem": "^3.0.14",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  }
}
